# EmailJS Configuration
# Get your credentials from https://dashboard.emailjs.com/

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Analytics Configuration
# Choose 'plausible' or 'google'
VITE_ANALYTICS_PROVIDER=plausible

# Plausible Analytics (recommended - privacy-friendly, no cookies)
# Your domain registered on Plausible
VITE_PLAUSIBLE_DOMAIN=yourdomain.com

# Google Analytics (optional)
# Your GA4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
